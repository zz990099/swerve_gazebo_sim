<?xml version="1.0"?>
<package format="3">
  <name>swerve_gazebo_sim</name>
  <version>0.6.2</version>
  <description>Independent four-module swerve chassis simulation for ROS 2 and Gazebo.</description>
  <maintainer email="188520056629@163.com">Binfeng Zhang</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <depend>geometry_msgs</depend>
  <depend>builtin_interfaces</depend>
  <build_depend>rosidl_default_generators</build_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>controller_interface</depend>
  <depend>pluginlib</depend>
  <depend>realtime_tools</depend>
  <exec_depend>rosgraph_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>forward_command_controller</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <depend>gz_ros2_control</depend>
  <build_depend condition="$ROS_DISTRO == humble">ignition-gazebo6</build_depend>
  <build_depend condition="$ROS_DISTRO == humble">ignition-plugin</build_depend>
  <build_depend condition="$ROS_DISTRO == jazzy">gz_sim_vendor</build_depend>
  <build_depend condition="$ROS_DISTRO == jazzy">gz_plugin_vendor</build_depend>
  <depend>hardware_interface</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>python3-psutil</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
