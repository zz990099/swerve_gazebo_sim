<?xml version="1.0"?>
<!-- SPDX-License-Identifier: Apache-2.0 -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="swerve_drive">
  <!-- Public simulation model: chassis geometry plus Gazebo plugins. -->
  <xacro:arg
    name="config_file"
    default="$(find swerve_gazebo_sim)/config/swerve.yaml"
  />
  <xacro:arg name="gazebo_version" default="ign" />
  <xacro:arg name="prefix" default="" />
  <xacro:arg name="namespace" default="" />
  <xacro:arg name="controllers_file" default="" />
  <xacro:arg name="publish_ground_truth" default="false" />

  <xacro:property
    name="settings"
    value="${xacro.load_yaml('$(arg config_file)')}"
  />

  <xacro:include
    filename="chassis.urdf.xacro"
  />
  <xacro:include
    filename="plugins.urdf.xacro"
  />

  <xacro:swerve_chassis
    prefix="$(arg prefix)"
    geometry="${settings['geometry']}"
    control="${settings['control']}"
  />

  <xacro:swerve_plugins
    prefix="$(arg prefix)"
    namespace="$(arg namespace)"
    controllers_file="$(arg controllers_file)"
    control="${settings['control']}"
    publish_ground_truth="$(arg publish_ground_truth)"
    gazebo_version="$(arg gazebo_version)"
  />
</robot>
