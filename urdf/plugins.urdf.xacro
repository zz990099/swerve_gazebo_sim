<?xml version="1.0"?>
<!-- SPDX-License-Identifier: Apache-2.0 -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Gazebo contact, ros2_control and validation plugins. -->
  <xacro:macro
    name="swerve_plugins"
    params="prefix namespace controllers_file control publish_ground_truth gazebo_version"
  >
    <xacro:property
      name="max_wheel_speed"
      value="${control['max_wheel_speed']}"
    />
    <xacro:property
      name="steering_limit"
      value="${control['steering_limit']}"
    />
    <xacro:property
      name="ground_truth_topic"
      value="${namespace + '/ground_truth/odom' if namespace else '/ground_truth/odom'}"
    />

    <xacro:macro name="wheel_contact" params="corner">
      <!-- High rolling traction with controlled lateral slip for differential yaw. -->
      <gazebo reference="${prefix}${corner}_wheel_link">
        <mu1>1.0</mu1>
        <mu2>0.2</mu2>
        <fdir1>1 0 0</fdir1>
      </gazebo>
    </xacro:macro>

    <xacro:wheel_contact corner="fl" />
    <xacro:wheel_contact corner="fr" />
    <xacro:wheel_contact corner="rl" />
    <xacro:wheel_contact corner="rr" />

    <xacro:macro name="control_module" params="name">
      <joint name="${prefix}${name}_wheel_joint">
        <command_interface name="velocity">
          <param name="min">${-max_wheel_speed}</param>
          <param name="max">${max_wheel_speed}</param>
        </command_interface>
        <state_interface name="position" />
        <state_interface name="velocity" />
      </joint>

      <joint name="${prefix}${name}_steering_joint">
        <command_interface name="position">
          <param name="min">${-steering_limit}</param>
          <param name="max">${steering_limit}</param>
        </command_interface>
        <state_interface name="position" />
        <state_interface name="velocity" />
      </joint>
    </xacro:macro>

    <ros2_control name="${prefix}SwerveSystem" type="system">
      <hardware>
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      </hardware>
      <xacro:control_module name="fl" />
      <xacro:control_module name="fr" />
      <xacro:control_module name="rl" />
      <xacro:control_module name="rr" />
    </ros2_control>

    <gazebo>
      <plugin
        filename="gz_ros2_control-system"
        name="gz_ros2_control::GazeboSimROS2ControlPlugin"
      >
        <parameters>${controllers_file}</parameters>
        <robot_param>robot_description</robot_param>
        <robot_param_node>robot_state_publisher</robot_param_node>
        <ros>
          <namespace>${namespace if namespace else '/'}</namespace>
        </ros>
      </plugin>
    </gazebo>

    <xacro:if value="${publish_ground_truth}">
      <xacro:if value="${gazebo_version == 'ign'}">
        <gazebo>
          <plugin
            filename="ignition-gazebo-odometry-publisher-system"
            name="ignition::gazebo::systems::OdometryPublisher"
          >
            <odom_frame>${prefix}world</odom_frame>
            <robot_base_frame>${prefix}base_footprint</robot_base_frame>
            <odom_publish_frequency>50</odom_publish_frequency>
            <dimensions>2</dimensions>
            <odom_topic>${ground_truth_topic}</odom_topic>
          </plugin>
        </gazebo>
      </xacro:if>

      <xacro:if value="${gazebo_version == 'gz'}">
        <gazebo>
          <plugin
            filename="gz-sim-odometry-publisher-system"
            name="gz::sim::systems::OdometryPublisher"
          >
            <odom_frame>${prefix}world</odom_frame>
            <robot_base_frame>${prefix}base_footprint</robot_base_frame>
            <odom_publish_frequency>50</odom_publish_frequency>
            <dimensions>2</dimensions>
            <odom_topic>${ground_truth_topic}</odom_topic>
          </plugin>
        </gazebo>
      </xacro:if>
    </xacro:if>
  </xacro:macro>
</robot>
