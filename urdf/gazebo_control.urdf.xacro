<?xml version="1.0"?>
<!-- SPDX-License-Identifier: Apache-2.0 -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="swerve_control" params="prefix namespace controllers_file wheel_speed steering_limit">
    <xacro:macro name="control_module" params="name">
      <joint name="${prefix}${name}_wheel_joint">
        <command_interface name="velocity"><param name="min">${-float(wheel_speed)}</param><param name="max">${wheel_speed}</param></command_interface>
        <state_interface name="position"/><state_interface name="velocity"/>
      </joint>
      <joint name="${prefix}${name}_steering_joint">
        <command_interface name="position"><param name="min">${-float(steering_limit)}</param><param name="max">${steering_limit}</param></command_interface>
        <state_interface name="position"/><state_interface name="velocity"/>
      </joint>
    </xacro:macro>
    <ros2_control name="${prefix}SwerveSystem" type="system">
      <hardware><plugin>gz_ros2_control/GazeboSimSystem</plugin></hardware>
      <xacro:control_module name="fl"/><xacro:control_module name="fr"/>
      <xacro:control_module name="rl"/><xacro:control_module name="rr"/>
    </ros2_control>
    <gazebo>
      <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>${controllers_file}</parameters>
        <robot_param>robot_description</robot_param>
        <!-- gz_ros2_control prepends its own ROS namespace to this node name. -->
        <robot_param_node>robot_state_publisher</robot_param_node>
        <ros><namespace>${namespace if namespace else '/'}</namespace></ros>
      </plugin>
    </gazebo>
  </xacro:macro>
</robot>
